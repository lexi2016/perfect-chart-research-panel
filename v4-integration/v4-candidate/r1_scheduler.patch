+"""Transient, read-only verifier used only by the existing PDF owner queue.
+
+It publishes nothing. The parent holds the PDF-owner lock and commits only a
+validated response. A kernel alarm limits a worker even if its parent dies.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import re
+import signal
+import sys
+from pathlib import Path
+
+MAX_INDEX_BYTES = 32 * 1024 * 1024
+GRAM_CACHE = 65536
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--data-root', required=True)
+    parser.add_argument('--document-id', required=True)
+    parser.add_argument('--fingerprint', required=True)
+    parser.add_argument('--owner-sha256', required=True)
+    parser.add_argument('--index-sha256', required=True)
+    parser.add_argument('--alarm-seconds', type=int, required=True)
+    parser.add_argument('--mode', choices=['FULL','SOURCE'], required=True)
+    args = parser.parse_args()
+    if not (1 <= args.alarm_seconds <= 12 and hasattr(signal, 'SIGALRM')):
+        return 2
+    signal.signal(signal.SIGALRM, signal.SIG_DFL)
+    signal.alarm(args.alarm_seconds)
+    try:
+        allowed_env = {'PATH', 'LANG', 'PYTHONNOUSERSITE', '__CF_USER_TEXT_ENCODING'}
+        if set(os.environ) - allowed_env:
+            raise ValueError('SEARCH_WORKER_ENVIRONMENT_INVALID')
+        app_root = Path(__file__).resolve().parent.parent
+        sys.path.insert(0, str(app_root))
+        import infrastructure.zsxq_pdf_ingestion as owner
+        import infrastructure.zsxq_pdf_search_index as search
+        if (Path(owner.__file__).resolve() != app_root/'infrastructure/zsxq_pdf_ingestion.py'
+                or Path(search.__file__).resolve() != app_root/'infrastructure/zsxq_pdf_search_index.py'
+                or _sha(Path(owner.__file__)) != args.owner_sha256
+                or _sha(Path(search.__file__)) != args.index_sha256
+                or not re.fullmatch(r'[0-9a-f]{64}', args.document_id)
+                or not re.fullmatch(r'[0-9a-f]{64}', args.fingerprint)):
+            raise ValueError('SEARCH_WORKER_IDENTITY_INVALID')
+        root = Path(args.data_root)
+        if not root.is_absolute() or not root.is_dir() or root.is_symlink():
+            raise ValueError('DATA_ROOT_INVALID')
+        class ReadOnlyCappedIO:
+            def __init__(self, root_path):
+                self.io = owner.SafeRoot(root_path)
+            def read_bytes(self, relative, *, max_bytes=64 * 1024 * 1024):
+                if relative == owner.STATE_RELATIVE:
+                    cap = MAX_INDEX_BYTES
+                elif '/pdfs/' in relative:
+                    cap = owner.MAX_PDF_BYTES
+                elif '/pages/' in relative:
+                    cap = 32 * 1024 * 1024
+                elif '/receipts/' in relative:
+                    cap = 2 * 1024 * 1024
+                else:
+                    cap = 16 * 1024 * 1024
+                return self.io.read_bytes(relative, max_bytes=min(max_bytes, cap))
+        class ReadOnlyCappedStore(owner.NativeDataStore):
+            def __init__(self, root_path):
+                super().__init__(root_path)
+                self._zsxq_pdf_io = ReadOnlyCappedIO(root_path)
+            def _read(self, relative):
+                return json.loads(self._zsxq_pdf_io.read_bytes(relative).decode('utf-8'))
+            def _write(self, *args, **kwargs):
+                raise ValueError('SEARCH_WORKER_WRITE_FORBIDDEN')
+        store = ReadOnlyCappedStore(root)
+        raw = owner._store_io(store).read_bytes(owner.STATE_RELATIVE, max_bytes=MAX_INDEX_BYTES)
+        index = json.loads(raw.decode('utf-8'))
+        if (not isinstance(index, dict) or index.get('schema_version') != 'v4.zsxq_pdf_ingestion_index.v1'
+                or any(not isinstance(index.get(key), dict) for key in ('sources', 'documents', 'ocr_cache'))):
+            raise ValueError('PROCESSING_INDEX_INVALID')
+        fingerprint, day, status = search._fingerprint(index, args.document_id)
+        if fingerprint != args.fingerprint or status != 'READY':
+            raise ValueError('SEARCH_WORKER_STALE')
+        if args.mode == 'SOURCE':
+            source, _ = owner._source_row_for_document(store, index, args.document_id)
+            print(json.dumps({'ok': True, 'document_id': args.document_id, 'research_date': day,
+                  'fingerprint': fingerprint, 'source_run_id': source.get('source_run_id')}, separators=(',', ':')), flush=True)
+            return 0
+        detail = owner._verified_document_detail(store, index, args.document_id, verify_pdf=True)
+        receipt, processing, source = detail['receipt'], detail['processing'], detail['source']
+        if (detail['status'] != 'READY' or receipt.get('integrity') != 'SOURCE_PDF_AND_PAGE_HASHES_VERIFIED'
+                or type(processing.get('verified_pdf_size')) is not int
+                or not 1 <= processing['verified_pdf_size'] <= owner.MAX_PDF_BYTES
+                or type(processing.get('verified_pages_size')) is not int
+                or not 1 <= processing['verified_pages_size'] <= 32 * 1024 * 1024
+                or not re.fullmatch(r'[0-9a-f]{64}', str(receipt.get('verified_pdf_sha256') or ''))
+                or not re.fullmatch(r'[0-9a-f]{64}', str(receipt.get('sha256') or ''))):
+            raise ValueError('SEARCH_WORKER_DETAIL_INVALID')
+        # Bound temporary bigram memory while preserving exactly the same bits.
+        bits = bytearray(search.BIT_BYTES)
+        grams: set[str] = set()
+        def flush() -> None:
+            for gram in grams:
+                for position in search._positions(gram):
+                    bits[position >> 3] |= 1 << (position & 7)
+            grams.clear()
+        segments = [str(source.get('topic_title') or ''), str(source.get('original_filename') or '')]
+        segments.extend(str(page.get('text') or '') for page in detail['pages'])
+        for segment in segments:
+            text = segment.casefold()
+            for i in range(len(text)-1):
+                grams.add(text[i:i+2])
+                if len(grams) >= GRAM_CACHE:
+                    flush()
+        flush()
+        result = {'ok': True, 'document_id': args.document_id, 'research_date': day,
+                  'fingerprint': fingerprint, 'source_run_id': source.get('source_run_id'),
+                  'verified_pdf_sha256': receipt['verified_pdf_sha256'],
+                  'verified_pdf_size': processing['verified_pdf_size'],
+                  'verified_pages_size': processing['verified_pages_size'],
+                  'receipt_sha256': receipt['sha256'], 'page_count': len(detail['pages']),
+                  'bloom': base64.b64encode(bits).decode('ascii')}
+        print(json.dumps(result, ensure_ascii=True, separators=(',', ':')), flush=True)
+        return 0
+    except Exception as error:
+        reason = getattr(error, 'code', None) or str(error)
+        if not re.fullmatch(r'[A-Z0-9_]{1,80}', str(reason)):
+            reason = type(error).__name__.upper()
+        print(json.dumps({'ok': False, 'reason': reason}, separators=(',', ':')), flush=True)
+        return 1
+    finally:
+        signal.alarm(0)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
