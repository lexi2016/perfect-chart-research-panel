+def _read_state(store: Any) -> dict[str, Any]:
+    try:
+        raw = owner._store_io(store).read_bytes(STATE_PATH, max_bytes=4096)
+    except FileNotFoundError:
+        return {'schema_version': STATE_SCHEMA, 'phase': 'SMALL', 'cursor_day': ''}
+    try:
+        value = json.loads(raw.decode('utf-8'))
+        if (not isinstance(value, dict) or value.get('schema_version') != STATE_SCHEMA
+                or value.get('phase') not in {'SMALL', 'LARGE'}
+                or not re.fullmatch(r'(?:[0-9]{8})?', str(value.get('cursor_day') or ''))
+                or not re.fullmatch(r'(?:[0-9]{8})?', str(value.get('last_large_day') or ''))):
+            raise ValueError('state')
+    except (ValueError, TypeError, UnicodeError) as error:
+        raise ValueError('SEARCH_MAINTENANCE_STATE_INVALID') from error
+    return value
+
+
+def _write_state(store: Any, state: Mapping[str, Any]) -> None:
+    raw = search._canonical(state)
+    if len(raw) > 4096:
+        raise ValueError('SEARCH_MAINTENANCE_STATE_TOO_LARGE')
+    owner._store_io(store).write_bytes(STATE_PATH, raw)
+
+
+def _read_bounded_index(store: Any) -> tuple[dict[str, Any], str]:
+    try:
+        raw = owner._store_io(store).read_bytes(owner.STATE_RELATIVE, max_bytes=MAX_OWNER_INDEX_BYTES)
+    except FileNotFoundError:
+        index = {'schema_version': 'v4.zsxq_pdf_ingestion_index.v1', 'sources': {}, 'documents': {}, 'ocr_cache': {}}
+        return index, hashlib.sha256(search._canonical(index)).hexdigest()
+    index = json.loads(raw.decode('utf-8'))
+    if (not isinstance(index, dict) or index.get('schema_version') != 'v4.zsxq_pdf_ingestion_index.v1'
+            or any(not isinstance(index.get(k), dict) for k in ('sources', 'documents', 'ocr_cache'))):
+        raise ValueError('PROCESSING_INDEX_INVALID')
+    return index, hashlib.sha256(raw).hexdigest()
